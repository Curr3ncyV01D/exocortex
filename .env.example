# Optional for browsing chats. Required for Gemini generation.
GEMINI_API_KEY=

# Application defaults. Uncomment only to override.
# GEMINI_MODEL=gemini-3.5-flash-lite
# MAX_CONTEXT_BYTES=512000
# DATABASE_URL=sqlite+aiosqlite:///./data/exocortex.db

# Compose defaults. DATABASE_URL inside the container is set by compose.yaml.
# EXOCORTEX_PORT=8080
# EXOCORTEX_DATA_DIR=./data
# EXOCORTEX_UID=1000
# EXOCORTEX_GID=1000
